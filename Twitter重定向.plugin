#!name = Twitter重定向
#!author = -SUKERO-
#!homepage = https://github.com/acerasukero/Loon-Plugins/blob/main/Twitter%E9%87%8D%E5%AE%9A%E5%90%91.plugin
#!icon = https://261213.xyz/Twitter.png
#!tag = 工具

[Rewrite]
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/?$/ then redirect(307, "twitter://")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/(?:(?:i\/(?:web\/)?|(?:[^\/?#]+\/)?)status\/|intent\/(?:retweet|like)\/?\?tweet_id=)(\d+)(?:\/[^?#]*)?(?:[?&][^#]*)?$/ as item then redirect(307, "twitter://status?id=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/messages\/?(?:\?[^#]*)?$/ then redirect(307, "twitter://messages")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/intent\/tweet\/?\?text=([^&]+)(?:&[^#]*)?$/ as item then redirect(307, "twitter://post?message=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/(?:compose\/(?:post|tweet)\/?(?:\?[^#]*)?|intent\/tweet\/?(?:\?(?!text=)[^#]*)?)$/ then redirect(307, "twitter://post")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/hashtag\/([^\/?#]+)(?:\?[^#]*)?$/ as item then redirect(307, "twitter://search?query=%23${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/search\/?\?q=([^&]+)(?:&[^#]*)?$/ as item then redirect(307, "twitter://search?query=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/(?:intent\/follow\/?\?screen_name=|(?!(?:home|explore|notifications|messages|bookmarks|communities|premium|verified|settings|compose|logout|login|signup|tos|privacy|search|hashtag|intent|i|share|like|retweet|follow|lists|status|jobs|about|download|help|en|language)(?:[\/?]|$))@?)([A-Za-z0-9_]{1,15})(?:\/(?:followers|following|verified_followers|media|likes|photo|header_photo|lists|communities|topics|highlights|articles))?\/?(?:[?&][^#]*)?$/ as item then redirect(307, "twitter://user?screen_name=${item.1}")

[Mitm]
hostname = x.com, www.x.com, mobile.x.com, m.x.com, twitter.com, www.twitter.com, mobile.twitter.com, m.twitter.com
