#!name = Twitter重定向
#!desc = 在 Safari 中把 X/Twitter 链接跳转到 Twitter 客户端。
#!tag = 工具

[Argument]
scheme = input,"twitter",type=string,tag=客户端 Scheme,desc=自签版 Twitter 的 URL Scheme，只填 scheme，不要带 ://。默认 twitter
fallback = switch,true,tag=未覆盖页面打开 App,desc=关闭后未覆盖的 X 页面仍留在 Safari

[Rewrite]
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/?$/ then redirect(307, "${scheme}://")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/(?:i\/(?:web\/)?status|(?:[^\/?#]+\/)?status)\/(\d+)(?:\/[^?#]*)?(?:\?[^#]*)?$/ as item then redirect(307, "${scheme}://status?id=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/compose\/(?:post|tweet)\/?(?:\?[^#]*)?$/ then redirect(307, "${scheme}://post")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/messages\/?(?:\?[^#]*)?$/ then redirect(307, "${scheme}://messages")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/([A-Za-z0-9_]{1,15})\/(?:followers|following|verified_followers|media|likes|photo|header_photo|lists|communities|topics|highlights|articles)\/?(?:\?[^#]*)?$/ as item then redirect(307, "${scheme}://user?screen_name=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/intent\/follow\/?\?screen_name=([A-Za-z0-9_]+)(?:&[^#]*)?$/ as item then redirect(307, "${scheme}://user?screen_name=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/intent\/tweet\/?\?text=([^&]+)(?:&[^#]*)?$/ as item then redirect(307, "${scheme}://post?message=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/intent\/tweet\/?(?:\?[^#]*)?$/ then redirect(307, "${scheme}://post")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/intent\/(?:retweet|like)\/?\?tweet_id=(\d+)(?:&[^#]*)?$/ as item then redirect(307, "${scheme}://status?id=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/hashtag\/([^\/?#]+)(?:\?[^#]*)?$/ as item then redirect(307, "${scheme}://search?query=%23${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/search\/?\?q=([^&]+)(?:&[^#]*)?$/ as item then redirect(307, "${scheme}://search?query=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com\/(?!(?:home|explore|notifications|messages|bookmarks|communities|premium|verified|settings|compose|logout|login|signup|tos|privacy|search|hashtag|intent|i|share|like|retweet|follow|lists|status|jobs|about|download|help|en|language)(?:\/)?(?:\?[^#]*)?$)@?([A-Za-z0-9_]{1,15})\/?(?:\?[^#]*)?$/ as item then redirect(307, "${scheme}://user?screen_name=${item.1}")
request if ${url} ~= /^https?:\/\/(?:www\.|mobile\.|m\.)?(?:x|twitter)\.com(?:\/.*)?$/ && ${request.header['Sec-Fetch-Dest']} == "document" && ${request.header['Sec-Fetch-Mode']} == "navigate" && ${fallback} == true then redirect(307, "${scheme}://")

[Mitm]
hostname = x.com, www.x.com, mobile.x.com, m.x.com, twitter.com, www.twitter.com, mobile.twitter.com, m.twitter.com
